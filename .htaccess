#php url configuration

RewriteEngine On

# ----------------------------------------------------------------------
# 1. SSL & WWW CANONICALIZATION (PRODUCTION ONLY)
# ----------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?theyyampattilgcc\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.theyyampattilgcc\.com$ [NC]
RewriteRule ^(.*)$ https://theyyampattilgcc.com/$1 [L,R=301]

# Redirect index.php to the root domain (Production only)
RewriteCond %{HTTP_HOST} ^(www\.)?theyyampattilgcc\.com$ [NC]
RewriteCond %{REQUEST_URI} ^/index\.php$
RewriteRule ^(.*)$ https://theyyampattilgcc.com/ [L,R=301]

# ----------------------------------------------------------------------
# 2. EXCLUSIONS
# ----------------------------------------------------------------------
# Prevent send-mail.php from being redirected so POST data stays intact
RewriteCond %{REQUEST_URI} !/send-mail\.php

# ----------------------------------------------------------------------
# 3. URL STRUCTURE & TRAILING SLASH LOGIC
# ----------------------------------------------------------------------
# A. Redirect direct /example.php requests to /example/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# B. Enforce Trailing Slash: Redirect /example to /example/
# Excludes actual existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

# C. Internal Rewrite: Map /example/ internally to /example.php
# Works automatically in subdirectories (localhost) and root domain (live server)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)/$ $1.php [L]


#Website performance configuration

# 1. COMPRESSION - Reduces file sizes for faster loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/ttf font/otf font/opentype image/svg+xml
</IfModule>

# 2. BROWSER CACHING - Stores assets locally to prevent jerking/re-loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # FORCE INSTANT LAYOUT & SCHEMA REFRESH FOR WEB PAGES
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  
  # Images (Smooth loading)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Video
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"
  
  # CSS/JS (Prevents layout shift/jumping)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Fonts (Critical for no-shaking text)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# 3. SETTINGS TO PREVENT RE-VALIDATION DELAYS
<IfModule mod_headers.c>
  # Fix for smooth scrolling/jerking (removes Etags to prevent validation lag)
  Header unset ETag
  FileETag None
  
  # Explicitly tell browsers NOT to cache structural page code/schema markup
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Cache Control for shared caches (Kept completely intact)
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 4. SECURITY & SMOOTHNESS HEADERS
<IfModule mod_headers.c>
  # Disable content type sniffing to speed up rendering
  Header set X-Content-Type-Options "nosniff"
</IfModule>